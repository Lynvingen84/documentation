# Kopier denne filen til secrets.yaml og fyll inn egne verdier.
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml er med i .gitignore og skal aldri committes.

wifi_ssid: "DITT_NETTVERK"
wifi_password: "DITT_WIFI_PASSORD"

# 32 tilfeldige bytes som base64. Generer en ny nøkkel her:
# https://esphome.io/components/api.html
# eller lokalt:
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "ERSTATT_MED_EGEN_NOKKEL"

# Passord for trådløs oppdatering (OTA).
ota_password: "ERSTATT_MED_EGET_PASSORD"
