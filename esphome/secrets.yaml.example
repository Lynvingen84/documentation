# ==================================================
# secrets.yaml.example
#
# Kopier denne til secrets.yaml i samme mappe og
# fyll inn ekte verdier. secrets.yaml er gitignorert
# og skal aldri committes.
#
#   cp secrets.yaml.example secrets.yaml
#
# Generer nye verdier til de to nederste med:
#
#   python3 -c "import os,base64; \
#     print(base64.b64encode(os.urandom(32)).decode())"
# ==================================================

wifi_ssid: "DITT_SSID"
wifi_password: "DITT_WIFI_PASSORD"

# 32 bytes base64 - brukes av Home Assistant ved
# tilkobling til enheten
api_encryption_key: "GENERER_EN_NY_NOEKKEL_HER"

ota_password: "GENERER_ET_NYTT_PASSORD_HER"
